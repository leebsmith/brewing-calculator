#!/usr/bin/env bash

# ==============================================================================
# Zero-Build Architecture Pre-Commit Linting Pipeline
# ==============================================================================
# This hook ensures that only fully linted, valid files are committed to the 
# repository. It utilizes plumbing-level Git commands to identify staged files 
# and routes them to ESLint, Stylelint, and PurgeCSS analysis.
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}▶ Initiating Zero-Build Pre-Commit Linting Pipeline...${NC}"

# Extract staged files
STAGED_FILES=$(git diff-index --cached --name-only --diff-filter=ACM HEAD 2>/dev/null || git diff-index --cached --name-only --diff-filter=ACM $(git hash-object -t tree /dev/null))

if [ -z "$STAGED_FILES" ]; then
  echo -e "${GREEN}✓ No files staged for commit. Bypassing linting pipeline.${NC}"
  exit 0
fi

# CSS Approval Gate Check
STYLE_FILE="frontend/style.css"
TOKENS_FILE="frontend/tokens.css"
CSS_STAGED=0

for FILE in $STAGED_FILES; do
  if [ "$FILE" = "$STYLE_FILE" ] || [ "$FILE" = "$TOKENS_FILE" ]; then
    CSS_STAGED=1
  fi
done

if [ "$CSS_STAGED" -eq 1 ]; then
  if [ "${CSS_APPROVED:-0}" != "1" ]; then
    echo "" >&2
    echo "ERROR: Staged modifications to design stylesheets require advance approval." >&2
    echo "Refer to GEMINI.md Section 10 (CSS Architecture & Styling Governance)." >&2
    echo "" >&2
    echo "To commit authorized modifications, re-run with:" >&2
    echo "  CSS_APPROVED=1 git commit" >&2
    echo "" >&2
    exit 1
  fi
  echo -e "${GREEN}==> CSS Authorization verified (CSS_APPROVED=1).${NC}"
fi

JS_FILES=""
CSS_FILES=""
HTML_FILES=""

for FILE in $STAGED_FILES; do
  if [ -f "$FILE" ]; then
    case "$FILE" in
      *.js)
        JS_FILES="$JS_FILES $FILE"
        ;;
      *.css)
        CSS_FILES="$CSS_FILES $FILE"
        ;;
      *.html)
        HTML_FILES="$HTML_FILES $FILE"
        ;;
    esac
  fi
done

HAS_ERROR=0

# Lint JavaScript and HTML files
if [ -n "$JS_FILES" ] || [ -n "$HTML_FILES" ]; then
  echo -e "${YELLOW}Executing ESLint against JavaScript and HTML markup...${NC}"
  if npx eslint $JS_FILES $HTML_FILES; then
    echo -e "${GREEN}✓ ESLint validation passed.${NC}"
  else
    echo -e "${RED}✗ ESLint detected violations. Refer to output above.${NC}"
    HAS_ERROR=1
  fi
fi

# Lint CSS files
if [ -n "$CSS_FILES" ]; then
  echo -e "${YELLOW}Executing Stylelint against stylesheets...${NC}"
  if npx stylelint $CSS_FILES; then
    echo -e "${GREEN}✓ Stylelint validation passed.${NC}"
  else
    echo -e "${RED}✗ Stylelint detected violations. Refer to output above.${NC}"
    HAS_ERROR=1
  fi
fi

# Execute PurgeCSS analysis
if { [ -n "$CSS_FILES" ] || [ -n "$HTML_FILES" ] || [ -n "$JS_FILES" ]; } && [ $HAS_ERROR -eq 0 ]; then
  echo -e "${YELLOW}Executing PurgeCSS analysis to detect orphaned CSS rules...${NC}"
  if node purgecss-linter.js; then
    echo -e "${GREEN}✓ PurgeCSS analysis passed. No dead code detected.${NC}"
  else
    echo -e "${RED}✗ PurgeCSS detected orphaned CSS rules. Commit aborted.${NC}"
    HAS_ERROR=1
  fi
fi

if [ $HAS_ERROR -ne 0 ]; then
  echo -e "${RED}====================================================${NC}"
  echo -e "${RED}COMMIT REJECTED: Code quality standards not met.${NC}"
  echo -e "${RED}Please resolve the errors detailed above and try again.${NC}"
  echo -e "${RED}====================================================${NC}"
  exit 1
else
  echo -e "${GREEN}====================================================${NC}"
  echo -e "${GREEN}COMMIT ACCEPTED: All zero-build quality checks passed.${NC}"
  echo -e "${GREEN}====================================================${NC}"
  exit 0
fi
