{
  "name": "brewing-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-build frontend and FastAPI backend batch brewing calculator",
  "scripts": {
    "lint:js": "eslint \"frontend/**/*.js\" \"frontend/**/*.html\"",
    "lint:css": "stylelint \"frontend/**/*.css\"",
    "lint:purge": "node purgecss-linter.js",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:purge"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@html-eslint/eslint-plugin": "^0.25.0",
    "@html-eslint/parser": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-alpinejs": "^1.3.2",
    "globals": "^15.0.0",
    "purgecss": "^7.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-declaration-strict-value": "^1.10.0",
    "stylelint-value-no-unknown-custom-properties": "^4.0.0"
  }
}
