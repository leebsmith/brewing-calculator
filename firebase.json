{
  "hosting": {
    "public": "public",
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "batch-brewing-calculator-backend",
          "region": "us-east4"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8181
    },
    "hosting": {
      "port": 5151
    },
    "ui": {
      "port": 4040,
      "enabled": true
    },
    "singleProjectMode": true
  }
}
